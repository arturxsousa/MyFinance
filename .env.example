# Database (Neon)
# Pooled connection — used by the app at runtime
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct connection — used by Drizzle migrations (no pgBouncer)
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Auth
# Random 32-byte secret for JWT signing — generate with: openssl rand -hex 32
AUTH_SECRET=

# Email (Resend) — get API key from resend.com
# For dev use onboarding@resend.dev; for prod use your verified domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
# Dev only: redirect all emails to your address (Resend test mode restriction)
EMAIL_DEV_OVERRIDE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin seed (used by db:seed to create the first Admin user)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
